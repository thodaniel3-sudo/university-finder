# ============================================================
# University Finder — Example environment file
# ============================================================
# Copy this file to `.env` and fill in real values.
#
# NEVER commit the real `.env` file. It is git-ignored.
# NEVER put real secrets in this `.env.example` file — it goes
# to GitHub and any real value here is a security incident.
#
# All values below are placeholders or empty. Replace them in
# your local `.env` (which is not tracked by git).
# ============================================================

# ---------- Flask ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-me-with-a-long-random-hex-string
FLASK_ENV=development

# Set to "true" in production (HTTPS-only cookies)
SESSION_COOKIE_SECURE=false

# ---------- Supabase ----------
# Copy from Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- Brave Search API (optional) ----------
# Leave empty to disable the web-search fallback in /search.
# Get a key at https://brave.com/search/api/ (requires card, free tier available)
BRAVE_SEARCH_API_KEY=

# ---------- Transactional email (optional, dormant by default) ----------
# Leave EMAIL_API_KEY empty unless you have a verified sending domain.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=